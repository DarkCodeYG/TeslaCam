{
  "name": "teslacam",
  "version": "1.2.0",
  "description": "TeslaCam 4-channel dashcam viewer with synchronized playback and export",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "build": "electron-vite build",
    "start": "unset ELECTRON_RUN_AS_NODE && electron-vite preview",
    "pack:mac": "electron-vite build && electron-builder --mac",
    "pack:win": "electron-vite build && electron-builder --win",
    "pack:linux": "electron-vite build && electron-builder --linux",
    "pack": "electron-vite build && electron-builder"
  },
  "keywords": [
    "tesla",
    "dashcam",
    "teslacam",
    "viewer"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.teslacam.viewer",
    "productName": "TeslaCam Viewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/@ffmpeg-installer/**/*"
    ],
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.video",
      "artifactName": "TeslaCam-Viewer-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico",
      "artifactName": "TeslaCam-Viewer-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resources/icon.png",
      "category": "Video",
      "artifactName": "TeslaCam-Viewer-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^6.0.2",
    "vite": "^7.3.1"
  }
}
